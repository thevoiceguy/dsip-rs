# dsip-node: a distroless image around the static (musl) binary. Build context: crates/dsip-node, with the binaries
# staged at dist/<amd64|arm64>/dsip-node and the empty state directory at dist/state (see packaging/build.sh).
# Multi-arch with `docker buildx --platform`. Nothing is pulled from Docker Hub: its anonymous rate limit (HTTP 429)
# trips on CI runners' shared addresses, so the state directory comes from the build context instead of a busybox
# stage, and the base is distroless on gcr.io.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
LABEL org.opencontainers.image.title="dsip-node" \
      org.opencontainers.image.description="DSIP hints node: overlay member, Mainline DHT participant, HTTP hints API" \
      org.opencontainers.image.source="https://github.com/thevoiceguy/DSIP" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
COPY --chmod=0755 dist/${TARGETARCH}/dsip-node /usr/bin/dsip-node
COPY packaging/container.toml /etc/dsip-node/config.toml
COPY --chown=65532:65532 --chmod=0700 dist/state /var/lib/dsip-node
USER 65532:65532
VOLUME ["/var/lib/dsip-node"]
EXPOSE 8080/tcp 4610/tcp 6881/udp
ENTRYPOINT ["/usr/bin/dsip-node", "--config", "/etc/dsip-node/config.toml"]
