# dsip-relay: a DSIP relay — binds devices by their verified hello (§13.2), routes their envelopes, holds them for
# offline recipients (§13.3), and is the presence and broadcast authority (§9.3, §22).
[Unit]
Description=DSIP relay (device binding, routing, store-and-forward, presence)
Documentation=https://github.com/thevoiceguy/dsip-rs/blob/main/docs/dsip-service-nodes-plan.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/dsip-relay --config /etc/dsip-relay/relay.toml
# SIGHUP reloads the TLS certificate from its files; bound devices stay bound (/usr/libexec/dsip-relay/install-certificate)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# No account to manage: a transient user owns /var/lib/dsip-relay (its key seed, the queue, its certificate)
DynamicUser=yes
StateDirectory=dsip-relay
StateDirectoryMode=0700
ConfigurationDirectory=dsip-relay
UMask=0077
LimitNOFILE=65536

# Sandbox: it needs the network and its state directory, nothing else. Port 443 needs a drop-in
# (systemctl edit dsip-relay): AmbientCapabilities=CAP_NET_BIND_SERVICE, CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# and PrivateUsers=no, since a capability inside the private user namespace cannot bind the host's ports
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
