#!/bin/sh
# Install a push credential (the APNs key, the FCM service account) where dsip-push alone can read it.
#
#   install-credential <file> <name>       e.g. install-credential AuthKey_ABC123.p8 apns-key.p8
#
# The service runs as a DynamicUser and cannot read root's files, so the file is copied into its state directory,
# /var/lib/<service>/credentials/<name>, readable only by the service; its config names it there. Restart the service
# to read it (`systemctl restart dsip-push`).
#
# Spec: none (infrastructure).
set -eu
SERVICE=$(basename "$(dirname "$(readlink -f "$0")")")
[ $# = 2 ] || { echo "usage: $0 <file> <name>" >&2; exit 2; }
SRC=$1; NAME=$2
[ -r "$SRC" ] || { echo "$0: cannot read $SRC" >&2; exit 1; }
case $NAME in */*|.*|'') echo "$0: <name> is a file name: $NAME" >&2; exit 2 ;; esac
# /var/lib/<service> is systemd's link to /var/lib/private/<service> (DynamicUser). Before the first start neither
# exists: create the private one as root; systemd hands the whole tree to the service's user when it starts.
install -d -m 0700 /var/lib/private
DIR=/var/lib/private/$SERVICE
install -d -m 0700 "$DIR"
OWNER=$(stat -c %u:%g "$DIR")
install -d -m 0700 -o "${OWNER%:*}" -g "${OWNER#*:}" "$DIR/credentials"
# whole or not at all: written beside, then renamed over the old one
install -m 0600 -o "${OWNER%:*}" -g "${OWNER#*:}" "$SRC" "$DIR/credentials/.$NAME.new"
mv -f "$DIR/credentials/.$NAME.new" "$DIR/credentials/$NAME"
echo "$SERVICE: $NAME installed as /var/lib/$SERVICE/credentials/$NAME; restart $SERVICE to read it"
