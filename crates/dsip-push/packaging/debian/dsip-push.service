# dsip-push: a DSIP push gateway (Wake Profile, draft) — devices enrol their APNs or FCM tokens, relays and mailboxes
# ask it to wake them (W§3, W§5).
[Unit]
Description=DSIP push gateway (Wake Profile: waking sleeping devices through APNs and FCM)
Documentation=https://github.com/thevoiceguy/dsip-rs/blob/main/docs/dsip-service-nodes-plan.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/dsip-push --config /etc/dsip-push/push.toml
# SIGHUP reloads the TLS certificate from its files (/usr/libexec/dsip-push/install-certificate)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# No account to manage: a transient user owns /var/lib/dsip-push (its key seed, its handle key, its certificate)
DynamicUser=yes
StateDirectory=dsip-push
StateDirectoryMode=0700
ConfigurationDirectory=dsip-push
UMask=0077
LimitNOFILE=65536

# Sandbox: it needs the network and its state directory, nothing else. Port 443 needs a drop-in
# (systemctl edit dsip-push): AmbientCapabilities=CAP_NET_BIND_SERVICE, CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# and PrivateUsers=no, since a capability inside the private user namespace cannot bind the host's ports
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
