# dsip-mailbox: a DSIP mailbox and hub — holds its identities' items, KeyPackages and blobs, and orders and fans out
# their groups' messages (Messaging Profile M§4–M§7).
[Unit]
Description=DSIP mailbox and hub (Messaging Profile)
Documentation=https://github.com/thevoiceguy/dsip-rs/blob/main/docs/dsip-service-nodes-plan.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/dsip-mailbox --config /etc/dsip-mailbox/mailbox.toml
# SIGHUP reloads the TLS certificate from its files; bound devices stay bound (/usr/libexec/dsip-mailbox/install-certificate)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# No account to manage: a transient user owns /var/lib/dsip-mailbox (its service key, mailbox.sqlite, its certificate)
DynamicUser=yes
StateDirectory=dsip-mailbox
StateDirectoryMode=0700
ConfigurationDirectory=dsip-mailbox
UMask=0077
LimitNOFILE=65536

# Sandbox: it needs the network and its state directory, nothing else
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
