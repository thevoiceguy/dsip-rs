# One host, one name: copy to .env, then ./init. Compose reads it for the variables in compose.yaml.
DSIP_NAME=dsip.example.com          # the DNS name: its A (and AAAA) record points at this host
PUBLIC_IP=203.0.113.10              # the address coturn relays on (on an interface of this host)
DSIP_SERVE_ANY=32                   # identities that may enrol at the mailbox by binding; owners: mailbox.toml
# DSIP_VERSION=latest               # the images' tag: a release (S8) pins one
# DSIP_HTTPS_PORT=443               # the host's ports, if one is taken
# DSIP_MAILBOX_PORT=9443
